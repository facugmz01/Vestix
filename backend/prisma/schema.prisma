datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "catalog", "inventory", "sales", "purchasing", "finance", "settings"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ==========================================
// 1. ENUMS
// ==========================================

enum ProductType {
  SINGLE
  VARIABLE
  COMBO

  @@schema("core")
}

// ==========================================
// 1. IDENTITY & RBAC MODULE
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas agregadas
  openedShifts     CashShift[]    @relation("OpenedShifts")
  closedShifts     CashShift[]    @relation("ClosedShifts")
  receivedReceipts GoodsReceipt[] @relation("ReceivedByUser")

  @@schema("core")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[]

  @@schema("core")
}

model Permission {
  id      String @id @default(uuid())
  action  String
  subject String
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id])

  @@schema("core")
}

// ==========================================
// 2. OUTBOX EVENT PATTERN
// ==========================================

model OutboxEvent {
  id          String    @id @default(uuid())
  aggregate   String // e.g., "SaleOrder", "InventoryMovement"
  aggregateId String // ID de la entidad afectada
  type        String // e.g., "ORDER_COMPLETED", "STOCK_ADJUSTED"
  payload     Json // Datos completos del evento en JSON
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@schema("core")
}

// ==========================================
// 3. CORE CORE/LOCATIONS MODULE
// ==========================================

model Branch {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  address           String?
  phone             String?
  isMain            Boolean            @default(false)
  isActive          Boolean            @default(true)
  settings          Json? // { taxId, posReceiptHeader, posReceiptFooter }
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  warehouses        Warehouse[]
  cashRegisters     CashRegister[]
  users             User[]
  financialAccounts FinancialAccount[] // Relación agregada

  @@schema("core")
}

model Warehouse {
  id            String          @id @default(uuid())
  name          String
  code          String?         @unique
  type          String?         @default("STORAGE")
  address       String?
  isActive      Boolean         @default(true)
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PurchaseOrder PurchaseOrder[]
  GoodsReceipt  GoodsReceipt[]
  locations     WarehouseLocation[]

  @@schema("core")
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  type        String    @default("BIN") // AREA | RACK | SHELF | BIN
  barcode     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([isActive])
  @@schema("core")
}

// ==========================================
// 4. CATALOG MODULE & BARCODES
// ==========================================

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt // Agregado para sync offline

  @@schema("catalog")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // Agregado para sync offline

  @@schema("catalog")
}

model Product {
  id            String                  @id @default(uuid())
  name          String
  baseSku       String?                 @unique
  description   String?
  categoryId    String
  category      Category                @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?                  @relation(fields: [brandId], references: [id])
  type          ProductType             @default(SINGLE)
  isVariable    Boolean                 @default(false) // Deprecated: migrar a type
  manageBatches Boolean                 @default(false)
  costPrice     Float                   @default(0)
  isActive      Boolean                 @default(true)
  isPublished   Boolean                 @default(false)
  images        Json                    @default("[]")
  metadata      Json                    @default("{}")
  variants      ProductVariant[]
  comboLines    ProductComboLine[]
  collections   ProductCollectionItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@schema("catalog")
}

model ProductVariant {
  id         String           @id @default(uuid())
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  sku        String           @unique
  barcode    String?          @unique // Código principal (opcional)
  barcodes   ProductBarcode[] // Soporte para Múltiples códigos de barra
  size       String?
  color      String?
  imageUrl   String?
  costPrice  Float            @default(0)
  basePrice  Float            @default(0)
  isActive   Boolean          @default(true)
  attributes Json             @default("{}")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  priceListEntries PriceListEntry[]
  priceHistory     PriceHistory[]
  wcMapping        WcVariantMapping?
  mlMapping        MlVariantMapping?
  shopifyMapping   ShopifyVariantMapping?
  comboUses        ProductComboLine[]
  batches          ProductBatch[]
  POLineItem       POLineItem[]
  GoodsReceiptLine GoodsReceiptLine[]

  @@schema("catalog")
}

// Soporte para múltiples códigos de barra por variante
model ProductBarcode {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  barcode   String         @unique
  type      String         @default("INTERNAL") // INTERNAL | MANUFACTURER
  createdAt DateTime       @default(now())

  @@schema("catalog")
}

model LabelTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  unit           String   @default("mm")
  labelWidth     Float
  labelHeight    Float
  paperType      String   @default("ROLL") // ROLL | SHEET
  paperWidth     Float?
  paperHeight    Float?
  marginTop      Float    @default(0)
  marginLeft     Float    @default(0)
  rowGap         Float    @default(0)
  colGap         Float    @default(0)
  colsPerRow     Int      @default(1)
  labelsPerSheet Int?
  layout         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("catalog")
}

model Attribute {
  id        String           @id @default(uuid())
  name      String           @unique // e.g., "Color", "Talle"
  values    AttributeValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt // Agregado

  @@schema("catalog")
}

model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String // e.g., "Rojo", "XL"
  createdAt   DateTime  @default(now())

  @@schema("catalog")
}

// ==========================================
// 4B. COMBOS & BATCHES MODULE (NEW)
// ==========================================

model ProductComboLine {
  id              String         @id @default(uuid())
  parentProductId String
  parentProduct   Product        @relation(fields: [parentProductId], references: [id], onDelete: Cascade)
  childVariantId  String
  childVariant    ProductVariant @relation(fields: [childVariantId], references: [id])
  quantity        Float

  @@schema("catalog")
}

model ProductCollection {
  id        String                  @id @default(uuid())
  name      String
  season    String?
  year      Int?
  isActive  Boolean                 @default(true)
  products  ProductCollectionItem[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@schema("catalog")
}

model ProductCollectionItem {
  id           String            @id @default(uuid())
  collectionId String
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([collectionId, productId])
  @@schema("catalog")
}

model ProductBatch {
  id                String              @id @default(uuid())
  variantId         String
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  stockLevels       StockLevel[]
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())

  @@unique([variantId, batchNumber])
  @@schema("catalog")
}

// ==========================================
// 5. PRICING & PROMOTIONS MODULE
// ==========================================

model PriceList {
  id                 String           @id @default(uuid())
  name               String           @unique
  code               String           @default("")
  type               String           @default("RETAIL") // RETAIL | WHOLESALE | VIP | PROMOTIONAL
  modifierPercentage Float            @default(0)
  currency           String           @default("ARS")
  margin             Float            @default(1.0)
  isActive           Boolean          @default(true)
  isPercentageBased  Boolean          @default(false)
  percentageDiscount Float?
  validFrom          DateTime?
  validTo            DateTime?
  isDefault          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  entries            PriceListEntry[]
  customers          Customer[]

  @@schema("catalog")
}

model PriceListEntry {
  id            String         @id @default(uuid())
  priceListId   String
  priceList     PriceList      @relation(fields: [priceListId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  overridePrice Float
  createdAt     DateTime       @default(now()) // Agregado
  updatedAt     DateTime       @updatedAt

  @@unique([priceListId, variantId])
  @@schema("catalog")
}

model PriceHistory {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListId String?
  oldPrice    Float
  newPrice    Float
  source      String         @default("MANUAL") // MANUAL | BULK | IMPORT | PROMO | PRICE_LIST
  changedBy   String?
  createdAt   DateTime       @default(now())

  @@index([variantId, createdAt])
  @@schema("catalog")
}

// ==========================================
// 6. CUSTOMER & CRM MODULE
// ==========================================

model Customer {
  id             String          @id @default(uuid())
  type           String          @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  /// Origin of the customer record: ADMIN | STOREFRONT | POS | IMPORT
  source         String          @default("ADMIN")
  fullName       String
  taxId          String?         @unique
  /// AFIP tax condition: RESPONSABLE_INSCRIPTO | MONOTRIBUTO | EXENTO | CONSUMIDOR_FINAL
  taxCondition   String?
  email          String?
  phone          String?
  creditLimit    Float           @default(0)
  usedCredit     Float           @default(0)
  isActive       Boolean         @default(true)
  priceListId    String?
  priceList      PriceList?      @relation(fields: [priceListId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  SaleOrder      SaleOrder[]
  loyaltyAccount LoyaltyAccount?

  @@index([source])
  @@index([phone])
  @@schema("sales")
}

model LoyaltyAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int      @default(0)
  tier       String   @default("STANDARD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("sales")
}

model GiftCard {
  id             String    @id @default(uuid())
  code           String    @unique
  balance        Float
  initialBalance Float
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  issuedTo       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@schema("sales")
}

// ==========================================
// 7. SALES & POINT OF SALE (POS) MODULE
// ==========================================

model SaleOrder {
  id                String    @id // V2: Idempotent Offline UUID
  branchId          String
  warehouseId       String?
  source            String
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  subtotal          Float
  cartDiscountTotal Float
  grandTotal        Float
  appliedPromotions Json      @default("[]")

  // Soporte legado/plano para compatibilidad inicial
  paymentMethod    String
  paymentAccountId String?

  // Soporte completo para múltiples pagos/pagos divididos
  payments SaleOrderPayment[]

  status       String   @default("COMPLETED") // COMPLETED | QUOTE | CANCELLED
  cashShiftId  String?
  issueInvoice Boolean  @default(true)
  createdAt    DateTime

  // E-commerce shipping
  shippingMethodId   String?
  shippingMethodName String?
  shippingCost       Float            @default(0)
  shippingAddress    ShippingAddress?

  fulfillment OrderFulfillment?
  syncedAt    DateTime          @default(now())

  lines              OrderLineItem[]
  invoices           Invoice[]
  variance           SaleOrderVariance?
  returns            SaleReturn[]
  FinancialAccount   FinancialAccount?  @relation(fields: [financialAccountId], references: [id])
  financialAccountId String?
  CashShift          CashShift?         @relation(fields: [cashShiftId], references: [id])

  @@index([createdAt])
  @@index([source])
  @@index([customerId])
  @@index([paymentMethod])
  @@index([status])
  @@index([syncedAt])
  @@schema("sales")
}

model ShippingAddress {
  id          String    @id @default(uuid())
  saleOrderId String    @unique
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String?
  address     String
  city        String
  state       String
  zipCode     String
  latitude    Float?
  longitude   Float?
  notes       String?
  createdAt   DateTime  @default(now())

  @@schema("sales")
}

model SaleOrderVariance {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       SaleOrder @relation(fields: [orderId], references: [id])
  posTotal    Float
  serverTotal Float
  difference  Float
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@schema("sales")
}

model OrderLineItem {
  id             String    @id @default(uuid())
  orderId        String
  order          SaleOrder @relation(fields: [orderId], references: [id])
  variantId      String
  categoryId     String
  quantity       Int
  basePrice      Float
  discountAmount Float
  finalPrice     Float

  // Preservación histórica e integridad en auditorías
  historicalSku  String? // Snapshot del SKU de la variante al momento de la venta
  historicalName String? // Snapshot del nombre descriptivo al momento de la venta
  historicalCost Float? // Costo exacto (WAC) al momento de vender para cálculo retroactivo de ganancias

  returnLines SaleReturnLine[]

  @@schema("sales")
}

// Soporte para pagos divididos en el POS
model SaleOrderPayment {
  id              String        @id @default(uuid())
  orderId         String
  order           SaleOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Float
  referenceId     String? // Referencia del cupón de tarjeta o transferencia
  createdAt       DateTime      @default(now())

  @@schema("sales")
}

model SaleReturn {
  id                String           @id @default(uuid())
  saleOrderId       String
  saleOrder         SaleOrder        @relation(fields: [saleOrderId], references: [id])
  branchId          String
  action            String // REFUND | EXCHANGE
  status            String           @default("PENDING") // PENDING | APPROVED | REJECTED
  totalRefundAmount Float
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lines             SaleReturnLine[]

  @@schema("sales")
}

model SaleReturnLine {
  id          String        @id @default(uuid())
  returnId    String
  return      SaleReturn    @relation(fields: [returnId], references: [id])
  orderLineId String
  orderLine   OrderLineItem @relation(fields: [orderLineId], references: [id])
  variantId   String
  quantity    Int
  unitPrice   Float // Precio original de venta
  condition   String        @default("NEW") // NEW | DEFECTIVE | USED
  reason      String?

  @@schema("sales")
}

// ==========================================
// 8. INVENTORY & STOCK MODULE
// ==========================================

model InventoryMovement {
  id                     String        @id @default(uuid())
  variantId              String
  batchId                String?
  batch                  ProductBatch? @relation(fields: [batchId], references: [id])
  sourceWarehouseId      String?
  destinationWarehouseId String?
  type                   String
  quantity               Int
  unitCost               Float
  referenceId            String?
  createdAt              DateTime      @default(now())

  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
  @@schema("inventory")
}

model StockLevel {
  id                String             @id @default(uuid())
  variantId         String // campo sin @unique - la unicidad la garantiza @@unique([variantId, warehouseId, batchId])
  warehouseId       String
  batchId           String?
  batch             ProductBatch?      @relation(fields: [batchId], references: [id])
  branchId          String?
  physicalQuantity  Int                @default(0)
  reservedQuantity  Int                @default(0)
  availableQuantity Int                @default(0)
  updatedAt         DateTime           @updatedAt
  reservations      StockReservation[]

  @@unique([variantId, warehouseId, batchId])
  @@index([variantId])
  @@schema("inventory")
}

model StockReservation {
  id           String     @id @default(uuid())
  stockLevelId String
  stockLevel   StockLevel @relation(fields: [stockLevelId], references: [id])
  variantId    String
  warehouseId  String
  quantity     Int
  orderId      String?
  cartId       String?
  status       String     @default("ACTIVE") // ACTIVE | CONSUMED | EXPIRED | CANCELLED
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([cartId])
  @@schema("inventory")
}

// Traslados inter-deposito - persistidos en DB (reemplaza array en memoria)
model StockTransfer {
  id                     String              @id @default(uuid())
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 String              @default("DRAFT") // DRAFT | IN_TRANSIT | COMPLETED | CANCELLED
  trackingNumber         String?
  notes                  String?
  requestedByUserId      String?
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  lines                  StockTransferLine[]

  @@index([status])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@schema("inventory")
}

model StockTransferLine {
  id               String        @id @default(uuid())
  transferId       String
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId        String
  quantity         Int
  receivedQuantity Int? // Cantidad efectivamente recibida
  createdAt        DateTime      @default(now())

  @@schema("inventory")
}

// ==========================================
// 9. SUPPLY CHAIN & PURCHASING MODULE
// ==========================================

model Supplier {
  id             String          @id @default(uuid())
  companyName    String
  contactName    String?
  taxId          String?         @unique
  email          String?
  phone          String?
  balance        Float           @default(0)
  currency       String          @default("ARS")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@schema("purchasing")
}

model PurchaseOrder {
  id                     String         @id @default(uuid())
  supplierId             String
  supplier               Supplier       @relation(fields: [supplierId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse      @relation(fields: [destinationWarehouseId], references: [id]) // Relación formalizada
  status                 String // DRAFT, ISSUED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  totalAmount            Float          @default(0)
  paidAmount             Float          @default(0)
  currency               String         @default("ARS")
  notes                  String?
  issuedAt               DateTime?
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  lines                  POLineItem[]
  receipts               GoodsReceipt[]

  @@schema("purchasing")
}

model POLineItem {
  id               String             @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  variantId        String
  variant          ProductVariant     @relation(fields: [variantId], references: [id])
  orderedQuantity  Int
  receivedQuantity Int                @default(0)
  unitCost         Float
  discountAmount   Float              @default(0)
  totalAmount      Float
  receiptLines     GoodsReceiptLine[]

  @@schema("purchasing")
}

model GoodsReceipt {
  id                     String             @id @default(uuid())
  purchaseOrderId        String
  purchaseOrder          PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse          @relation(fields: [destinationWarehouseId], references: [id]) // Relación formalizada
  receivedByUserId       String?
  receivedByUser         User?              @relation("ReceivedByUser", fields: [receivedByUserId], references: [id]) // Relación formalizada
  status                 String // DRAFT, DISPUTED, VALIDATED
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  lines                  GoodsReceiptLine[]

  @@schema("purchasing")
}

model GoodsReceiptLine {
  id                  String         @id @default(uuid())
  receiptId           String
  receipt             GoodsReceipt   @relation(fields: [receiptId], references: [id])
  poLineItemId        String
  poLineItem          POLineItem     @relation(fields: [poLineItemId], references: [id])
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id]) // Relación formalizada
  expectedQuantity    Int
  receivedQuantity    Int
  difference          Int
  batchLot            String? // Lote provisto al momento de recepción
  batchExpirationDate DateTime? // Vencimiento provisto al momento de recepción
  notes               String?

  @@schema("purchasing")
}

// ==========================================
// 10. FINANCIALS, PAYMENTS & BILLING MODULE
// ==========================================

model Invoice {
  id                     String    @id @default(uuid())
  orderId                String
  order                  SaleOrder @relation(fields: [orderId], references: [id])
  type                   String
  cae                    String?
  caeExpiration          DateTime?
  receiptNumber          String?
  customerDocumentType   String
  customerDocumentNumber String
  netAmount              Float
  vatAmount              Float
  totalAmount            Float
  status                 String
  afipErrorMessage       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@schema("finance")
}

model FinancialAccount {
  id             String                 @id @default(uuid())
  name           String
  type           String                 @default("CASH") // CASH | BANK | CREDIT_CARD | EXPENSE | REVENUE
  currency       String                 @default("ARS")
  branchId       String?
  branch         Branch?                @relation(fields: [branchId], references: [id]) // Relación formalizada
  balance        Float                  @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinancialTransaction[]
  paymentMethods PaymentMethod[]

  // Relaciones inversas agregadas
  saleOrders       SaleOrder[]
  paymentReceipts  PaymentReceipt[]
  treasuryReceipts TreasuryReceipt[]

  @@schema("finance")
}

model FinancialTransaction {
  id          String           @id @default(uuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id])
  type        String // DEBIT | CREDIT
  amount      Float
  referenceId String
  description String
  createdAt   DateTime         @default(now())

  @@schema("finance")
}

model PaymentReceipt {
  id          String           @id @default(uuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id]) // Relación formalizada
  amount      Float
  payerName   String
  referenceId String
  issuedAt    DateTime         @default(now())

  @@schema("finance")
}

model TreasuryReceipt {
  id          String           @id @default(uuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id]) // Relación formalizada
  amount      Float
  payerName   String
  referenceId String?
  description String?
  createdAt   DateTime         @default(now())

  @@schema("finance")
}

model CashRegister {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  status         String          @default("CLOSED") // OPEN | CLOSED
  isActive       Boolean         @default(true)
  shifts         CashShift[]
  paymentMethods PaymentMethod[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@schema("finance")
}

model PaymentMethod {
  id             String            @id @default(uuid())
  name           String
  type           String // CASH | BANK_TRANSFER | CREDIT_CARD | CUSTOMER_CREDIT
  cashRegisterId String?
  cashRegister   CashRegister?     @relation(fields: [cashRegisterId], references: [id])
  accountId      String?
  account        FinancialAccount? @relation(fields: [accountId], references: [id])
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relación inversa agregada
  orderPayments SaleOrderPayment[]

  @@schema("finance")
}

model CashShift {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  openedByUserId String
  openedByUser   User         @relation("OpenedShifts", fields: [openedByUserId], references: [id]) // Relación formalizada
  closedByUserId String?
  closedByUser   User?        @relation("ClosedShifts", fields: [closedByUserId], references: [id]) // Relación formalizada
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?
  difference     Float?
  status         String       @default("OPEN") // OPEN | CLOSED
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  notes          String?
  sales          SaleOrder[]

  @@schema("finance")
}

model CurrentAccountMovement {
  id           String   @id @default(uuid())
  accountId    String
  entityType   String   // CUSTOMER | SUPPLIER
  documentType String   // RECEIPT | CREDIT_NOTE | DEBIT_NOTE
  referenceId  String
  description  String
  amount       Float
  debit        Float    @default(0)
  credit       Float    @default(0)
  balanceAfter Float
  dueDate      DateTime?
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([entityType])
  @@index([createdAt])
  @@schema("finance")
}

// ==========================================
// 11. AUDITING MODULE
// ==========================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  userEmail     String?
  ipAddress     String?
  action        String
  resource      String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  module        String?
  description   String?
  createdAt     DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@schema("core")
}

// ==========================================
// 12. INTEGRATIONS MODULE
// ==========================================

model IntegrationLog {
  id        String   @id @default(uuid())
  provider  String // AFIP, WOOCOMMERCE, etc.
  direction String // INBOUND, OUTBOUND
  action    String // STOCK_UPDATE, INVOICE_GENERATE
  status    String // PENDING, SUCCESS, FAILED, RETRYING
  payload   Json?
  response  Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("core")
}

model OfflineSyncLog {
  id                String    @id @default(uuid())
  clientGeneratedId String    @unique
  branchId          String
  userId            String
  type              String // SyncOperationType
  payload           Json
  clientTimestamp   DateTime
  status            String // SyncStatus
  conflictDetails   Json? // Optional conflict info
  appliedAt         DateTime?
  serverTimestamp   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@schema("core")
}

// ==========================================
// 13. BACKUPS MODULE
// ==========================================

model BackupJob {
  id             String    @id @default(uuid())
  filename       String?
  filePath       String?
  fileSize       BigInt?
  format         String    @default("SQL") // SQL
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  type           String    @default("MANUAL") // MANUAL, RESTORE
  description    String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@schema("core")
}

model WcVariantMapping {
  id            String   @id @default(uuid())
  variantId     String   @unique
  wcProductId   Int
  wcVariationId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@schema("core")
}

model MlVariantMapping {
  id            String         @id @default(uuid())
  variantId     String         @unique
  mlItemId      String
  mlVariationId String?
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@schema("core")
}

model ShopifyVariantMapping {
  id                String   @id @default(uuid())
  variantId         String   @unique
  shopifyProductId  String
  shopifyVariantId  String
  inventoryItemId   String?
  lastSyncAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopifyVariantId])
  @@schema("core")
}

// ==========================================
// 13. SETTINGS MODULE
// ==========================================

model SystemSettings {
  id            String   @id @default("default") // Singleton
  general       Json     @default("{}")
  pricing       Json     @default("{}")
  skuBarcode    Json     @default("{}")
  invoicing     Json     @default("{}")
  notifications Json     @default("{}")
  integrations  Json     @default("{}")
  offline       Json     @default("{}")
  pos           Json     @default("{}")
  arca          Json     @default("{}")
  storefront    Json     @default("{}")
  pwa           Json     @default("{}")
  qr            Json     @default("{}")
  labelPrinting Json     @default("{}")
  loyalty       Json     @default("{}")
  updatedAt     DateTime @updatedAt

  @@schema("settings")
}

// ==========================================
// 14. NOTIFICATIONS MODULE
// ==========================================

model NotificationTemplate {
  id        String            @id @default(uuid())
  name      String
  event     String // e.g., 'SALE_CONFIRMED', 'LOW_STOCK_ALERT'
  channel   String // 'EMAIL', 'WHATSAPP', 'SMS', 'PUSH'
  subject   String? // Mostly for email
  body      String            @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  logs      NotificationLog[]

  @@unique([event, channel])
  @@schema("core")
}

model NotificationLog {
  id           String                @id @default(uuid())
  templateId   String?
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  event        String // mirrors TemplateKey / NotificationEvent
  channel      String // 'EMAIL', 'WHATSAPP', 'SMS', 'PUSH'
  recipient    String // email or phone number
  referenceId  String? // SaleOrder, PO, etc.
  status       String                @default("PENDING") // PENDING | SENT | DELIVERED | FAILED | BOUNCED
  errorMessage String?               @db.Text
  variables    Json                  @default("{}")
  sentAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([event])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@schema("core")
}

model StaffNotification {
  id          String    @id @default(uuid())
  userId      String?
  title       String
  body        String    @db.Text
  event       String?
  referenceId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
  @@schema("core")
}

// ==========================================
// 15. NEW MIGRATED MODELS
// ==========================================

model PromotionRule {
  id         String    @id @default(uuid())
  name       String
  type       String
  isActive   Boolean   @default(true)
  conditions Json
  actions    Json
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@schema("core")
}

model PaymentIntent {
  id                  String   @id @default(uuid())
  provider            String
  externalReferenceId String
  orderId             String
  amount              Float
  currency            String   @default("ARS")
  status              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@schema("core")
}

model OrderFulfillment {
  id             String    @id @default(uuid())
  saleOrderId    String    @unique
  saleOrder      SaleOrder @relation(fields: [saleOrderId], references: [id])
  status         String
  trackingNumber String?
  courierName    String?
  paidAt         DateTime?
  pickedAt       DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  delivery       Delivery?

  @@schema("core")
}

model Delivery {
  id                    String           @id @default(uuid())
  fulfillmentId         String           @unique
  fulfillment           OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  status                String           @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | ARRIVED | DELIVERED | FAILED
  driverName            String?
  driverPhone           String?
  dispatchedAt          DateTime?
  estimatedArrival      DateTime?
  deliveryCode          String?
  deliveryCodeExpiresAt DateTime?
  trackingToken         String?          @unique
  driverToken           String?          @unique
  carrierType           String?
  carrierShipmentId     String?
  labelUrl              String?
  lastLatitude          Float?
  lastLongitude         Float?
  lastLocationAt        DateTime?
  proofPhotoUrl         String?
  failureReason         String?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  validations           DeliveryValidation[]

  @@index([status])
  @@schema("core")
}

model DeliveryValidation {
  id         String    @id @default(uuid())
  deliveryId String
  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  method     String    // OTP | MANUAL | CUSTOMER_CONFIRM
  status     String    // PENDING | PASSED | FAILED
  metadata   Json      @default("{}")
  validatedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([deliveryId])
  @@schema("core")
}

model CartHold {
  id          String   @id
  warehouseId String
  branchId    String
  customerId  String?
  lines       Json
  status      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("core")
}
