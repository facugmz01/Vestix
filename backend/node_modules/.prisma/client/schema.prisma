datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id      String @id @default(uuid())
  action  String
  subject String
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id])
}

model Customer {
  id          String      @id @default(uuid())
  type        String      @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  fullName    String
  taxId       String?     @unique
  email       String?
  phone       String?
  creditLimit Float       @default(0)
  usedCredit  Float       @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      SaleOrder[]
}

model Supplier {
  id             String          @id @default(uuid())
  companyName    String
  contactName    String?
  taxId          String?         @unique
  email          String?
  phone          String?
  balance        Float           @default(0)
  currency       String          @default("ARS")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Branch {
  id         String      @id @default(uuid())
  name       String
  code       String      @unique
  address    String?
  phone      String?
  isMain     Boolean     @default(false)
  isActive   Boolean     @default(true)
  settings   Json?       // { taxId, posReceiptHeader, posReceiptFooter }
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders         SaleOrder[]
  warehouses     Warehouse[]
  cashRegisters  CashRegister[]
  stockLevels    StockLevel[]
  returns        SaleReturn[] // Added relation
  users          User[]
}

model Warehouse {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique
  type        String?      @default("STORAGE")
  address     String?
  isActive    Boolean      @default(true)
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id])
  stockLevels StockLevel[]
  sourceMovements      InventoryMovement[] @relation("SourceMovements")
  destinationMovements InventoryMovement[] @relation("DestinationMovements")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String           @id @default(uuid())
  name        String
  baseSku     String?          @unique
  description String?
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  
  // --- New Fields ---
  isVariable  Boolean          @default(false)
  costPrice   Float            @default(0)
  
  isActive    Boolean          @default(true)
  isPublished Boolean          @default(false)
  images      Json             @default("[]")
  metadata    Json             @default("{}")
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  sku        String          @unique
  barcode    String?         @unique
  size       String?
  color      String?
  imageUrl   String?
  
  // Pricing Inheritance
  costPrice  Float           @default(0)
  basePrice  Float           @default(0) 
  
  isActive   Boolean         @default(true)
  attributes Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orderLines OrderLineItem[]
  poLines    POLineItem[]
  stockLevels StockLevel[]
  movements   InventoryMovement[]
  priceListEntries PriceListEntry[]
}

model Attribute {
  id        String           @id @default(uuid())
  name      String           @unique // e.g., "Color", "Talle"
  values    AttributeValue[]
  createdAt DateTime         @default(now())
}

model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String    // e.g., "Rojo", "XL"
  createdAt   DateTime  @default(now())
}

model PriceList {
  id                String           @id @default(uuid())
  name              String           @unique
  type              String           @default("RETAIL") // RETAIL | WHOLESALE | VIP | PROMOTIONAL
  currency          String           @default("ARS")
  margin            Float            @default(1.0)
  isActive          Boolean          @default(true)
  isPercentageBased Boolean          @default(false)
  percentageDiscount Float?
  validFrom         DateTime?
  validTo           DateTime?
  isDefault         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  entries           PriceListEntry[]
}

model PriceListEntry {
  id            String    @id @default(uuid())
  priceListId   String
  priceList     PriceList @relation(fields: [priceListId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  overridePrice Float
  updatedAt     DateTime  @updatedAt

  @@unique([priceListId, variantId])
}

model SaleOrder {
  id                String          @id // V2: Idempotent Offline UUID
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id])
  warehouseId       String?         // Added to track the source warehouse for stock deduction
  source            String
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id])
  subtotal          Float
  cartDiscountTotal Float
  grandTotal        Float
  appliedPromotions Json            @default("[]")
  paymentMethod     String
  paymentAccountId  String?
  status            String          @default("COMPLETED") // COMPLETED | QUOTE | CANCELLED
  cashShiftId       String?
  cashShift         CashShift?      @relation(fields: [cashShiftId], references: [id])
  createdAt         DateTime
  syncedAt          DateTime        @default(now())

  lines             OrderLineItem[]
  invoices          Invoice[]
  variance          SaleOrderVariance?
  returns           SaleReturn[] // Added relation

  @@index([createdAt])
  @@index([source])
  @@index([customerId])
  @@index([paymentMethod])
}

// V2: Offline Price Divergence Tracking
model SaleOrderVariance {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       SaleOrder @relation(fields: [orderId], references: [id])
  posTotal    Float
  serverTotal Float
  difference  Float
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model OrderLineItem {
  id             String         @id @default(uuid())
  orderId        String
  order          SaleOrder      @relation(fields: [orderId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  categoryId     String
  quantity       Int
  basePrice      Float
  discountAmount Float
  finalPrice     Float
  returnLines    SaleReturnLine[] // Added relation to track which items were returned
}

model SaleReturn {
  id                String           @id @default(uuid())
  saleOrderId       String
  saleOrder         SaleOrder        @relation(fields: [saleOrderId], references: [id])
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id])
  action            String           // REFUND | EXCHANGE
  status            String           @default("PENDING") // PENDING | APPROVED | REJECTED
  totalRefundAmount Float
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lines             SaleReturnLine[]
}

model SaleReturnLine {
  id           String         @id @default(uuid())
  returnId     String
  return       SaleReturn     @relation(fields: [returnId], references: [id])
  orderLineId  String
  orderLine    OrderLineItem  @relation(fields: [orderLineId], references: [id])
  variantId    String
  quantity     Int
  unitPrice    Float          // Price at which it was originally sold
  condition    String         @default("NEW") // NEW | DEFECTIVE | USED
  reason       String?
}

model InventoryMovement {
  id                     String   @id @default(uuid())
  variantId              String
  variant                ProductVariant @relation(fields: [variantId], references: [id])
  sourceWarehouseId      String?
  sourceWarehouse        Warehouse? @relation("SourceMovements", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("DestinationMovements", fields: [destinationWarehouseId], references: [id])
  type                   String
  quantity               Int
  unitCost               Float
  referenceId            String?
  createdAt              DateTime @default(now())

  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
}

model StockLevel {
  id                String             @id @default(uuid())
  variantId         String
  variant           ProductVariant     @relation(fields: [variantId], references: [id])
  warehouseId       String
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  branchId          String?
  branch            Branch?            @relation(fields: [branchId], references: [id])
  physicalQuantity  Int                @default(0)
  reservedQuantity  Int                @default(0)
  availableQuantity Int                @default(0)
  updatedAt         DateTime           @updatedAt
  reservations      StockReservation[]

  @@unique([variantId, warehouseId])
  @@index([variantId])
}

/// Explicit e-commerce stock hold.
/// Created when a cart checkout is initiated; consumed or released on payment outcome.
/// The expiry cleanup job targets ACTIVE records where expiresAt < now().
model StockReservation {
  id           String      @id @default(uuid())
  stockLevelId String
  stockLevel   StockLevel  @relation(fields: [stockLevelId], references: [id])
  variantId    String
  warehouseId  String
  quantity     Int
  orderId      String?     // Populated once checkout converts the reservation to a sale
  cartId       String?     // Source cart/session that created this hold
  status       String      @default("ACTIVE") // ACTIVE | CONSUMED | EXPIRED | CANCELLED
  expiresAt    DateTime    // Hard expiry deadline
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, expiresAt]) // Critical index for the cleanup job query
  @@index([orderId])
  @@index([cartId])
}

model PurchaseOrder {
  id                     String       @id @default(uuid())
  supplierId             String
  supplier               Supplier     @relation(fields: [supplierId], references: [id])
  destinationWarehouseId String
  status                 String       // DRAFT, ISSUED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  totalAmount            Float        @default(0)
  paidAmount             Float        @default(0)
  currency               String       @default("ARS")
  notes                  String?
  issuedAt               DateTime?
  completedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  lines                  POLineItem[]
  receipts               GoodsReceipt[]
}

model POLineItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  orderedQuantity  Int
  receivedQuantity Int            @default(0)
  unitCost         Float
  discountAmount   Float          @default(0)
  totalAmount      Float
  receiptLines     GoodsReceiptLine[]
}

model GoodsReceipt {
  id                     String       @id @default(uuid())
  purchaseOrderId        String
  purchaseOrder          PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  destinationWarehouseId String
  receivedByUserId       String?
  status                 String       // DRAFT, DISPUTED, VALIDATED
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  lines                  GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id               String       @id @default(uuid())
  receiptId        String
  receipt          GoodsReceipt @relation(fields: [receiptId], references: [id])
  poLineItemId     String
  poLineItem       POLineItem   @relation(fields: [poLineItemId], references: [id])
  variantId        String
  expectedQuantity Int
  receivedQuantity Int
  difference       Int
  notes            String?
}

model Invoice {
  id                     String    @id @default(uuid())
  orderId                String
  order                  SaleOrder @relation(fields: [orderId], references: [id])
  type                   String
  cae                    String?
  caeExpiration          DateTime?
  receiptNumber          String?
  customerDocumentType   String
  customerDocumentNumber String
  netAmount              Float
  vatAmount              Float
  totalAmount            Float
  status                 String
  afipErrorMessage       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  userEmail     String?
  ipAddress     String?
  action        String
  resource      String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  module        String?
  description   String?
  createdAt     DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model FinancialAccount {
  id             String                 @id @default(uuid())
  name           String
  type           String                 @default("CASH") // CASH | BANK | CREDIT_CARD | EXPENSE | REVENUE
  currency       String                 @default("ARS")
  branchId       String?
  balance        Float                  @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinancialTransaction[]
  paymentMethods PaymentMethod[]
}

model FinancialTransaction {
  id          String           @id @default(uuid())
  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id])
  type        String           // DEBIT | CREDIT
  amount      Float
  referenceId String
  description String
  createdAt   DateTime         @default(now())
}

model PaymentReceipt {
  id          String   @id @default(uuid())
  accountId   String
  amount      Float
  payerName   String
  referenceId String
  issuedAt    DateTime @default(now())
}

model TreasuryReceipt {
  id          String   @id @default(uuid())
  accountId   String
  amount      Float
  payerName   String
  referenceId String?
  description String?
  createdAt   DateTime @default(now())
}

model CashRegister {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  status         String          @default("CLOSED") // OPEN | CLOSED
  isActive       Boolean         @default(true)
  shifts         CashShift[]
  paymentMethods PaymentMethod[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PaymentMethod {
  id               String            @id @default(uuid())
  name             String
  type             String            // CASH | BANK_TRANSFER | CREDIT_CARD | CUSTOMER_CREDIT
  
  // Associating CASH with a CashRegister
  cashRegisterId   String?           
  cashRegister     CashRegister?     @relation(fields: [cashRegisterId], references: [id])
  
  // Associating BANK_TRANSFER / CREDIT_CARD with a FinancialAccount (Cuenta Bancaria)
  accountId        String?           
  account          FinancialAccount? @relation(fields: [accountId], references: [id])
  
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CashShift {
  id              String       @id @default(uuid())
  cashRegisterId  String
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  openedByUserId  String
  closedByUserId  String?
  openingAmount   Float
  closingAmount   Float?
  expectedAmount  Float?
  difference      Float?
  status          String       @default("OPEN") // OPEN | CLOSED
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  notes           String?
  sales           SaleOrder[]
}
