# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# -----------------------------------------------------------------------------
# WARNING: Do NOT commit your actual .env file to version control.
# Use AWS Secrets Manager, Vercel Env, or Hashicorp Vault in production.
# -----------------------------------------------------------------------------

# [APP CORE]
NODE_ENV=production
PORT=3000

# [DATABASE]
# PostgreSQL connection string. Must point to a managed DB (e.g. AWS RDS)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&pool_timeout=10"

# [SECURITY]
# JWT signing key. MUST be > 64 chars, cryptographically random in production.
# Generate via: openssl rand -base64 64
JWT_SECRET="replace_me_with_long_random_string_in_production"

# [CORS / FRONTEND]
# The exact URL of the production frontend (no trailing slash). Required for HttpOnly Cookies.
FRONTEND_URL="https://pos.mycompany.com"

# [STOREFRONT / TIENDA ONLINE]
# The public domain or subdomain for the e-commerce storefront.
# If set, this domain is automatically added to the CORS whitelist.
# Any tienda.* subdomain is also automatically allowed.
# Example: tienda.roindumentaria.com.ar
STOREFRONT_DOMAIN="tienda.mycompany.com"

# [REDIS / QUEUES]
# Required for BullMQ (AFIP integration) and API Rate Limiting.
REDIS_HOST="redis.internal.mycompany.com"
REDIS_PORT=6379
# REDIS_PASSWORD="if_applicable"

# [INTEGRATIONS - AFIP]
# Path to the production AFIP certificates and tokens
AFIP_CERT_PATH="/run/secrets/afip_cert.crt"
AFIP_KEY_PATH="/run/secrets/afip_key.key"
AFIP_CUIT="30000000000"
