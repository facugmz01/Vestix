# Copy to `.env` before first install:
#   cp .env.docker.example .env
#
# NEVER commit the real `.env` file.

# ── Public URL (no trailing slash) ───────────────────────────────────────────
# Examples: https://erp.miempresa.com  |  http://192.168.1.50
APP_URL=http://localhost

# Host port mapped to the web container
HTTP_PORT=80

# Optional public storefront hostname (blank = disabled)
STOREFRONT_DOMAIN=

# Image / release tag used by compose + update script
VESTIX_VERSION=latest

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=erp_prod
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change_me_strong_db_password

# ── Security (REQUIRED) ──────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=change_me_long_random_jwt_secret

# Exactly 32 bytes as base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64

# Auth cookies: set "true" behind HTTPS (recommended).
# Set "false" only for local/lab HTTP deploys (browsers reject Secure cookies on http://).
COOKIE_SECURE=false

# ── Optional integrations ────────────────────────────────────────────────────
# AFIP_ACCESS_TOKEN=
# AFIP_CUIT=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# EVOLUTION_WEBHOOK_SECRET=

# Set true only for emergency boots that must skip prisma db push
SKIP_DB_SYNC=false

VITE_APP_NAME=Vestix
