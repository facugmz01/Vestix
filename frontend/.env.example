VITE_API_BASE=/api
VITE_APP_NAME=ERP Retail
VITE_APP_VERSION=1.0.0
VITE_ENV=development

# --- Storefront (Tienda Web) ---
# Set this to the public domain/subdomain for the storefront.
# When a visitor lands on this domain, the app shows the store instead of the admin panel.
# Example: tienda.roindumentaria.com.ar  OR  shop.mituenda.com.ar
VITE_STOREFRONT_DOMAIN=
